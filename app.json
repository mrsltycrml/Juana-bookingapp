{
  "expo": {
    "name": "Juana Beauty and Aesthetics",
    "slug": "juana-beauty-booking",
    "scheme": "juanabeauty",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.juanabeauty.booking"
    },
    "android": {
      "package": "com.juanabeauty.booking",
      "permissions": [
        "NOTIFICATIONS"
      ]
    }
  }
}
